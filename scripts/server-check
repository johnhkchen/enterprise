#!/usr/bin/env bash
# Before setting up the headless dev server: says when it was last set up and when its log last changed, and whether a
# dev server still holds the world. A server still running waits up to 60 seconds to finish saving, then this fails
# with what to do, rather than waiting forever (a forgotten server has hung test runs before).
set -u
run=core/run
ago() {
    local s=$(( $(date +%s) - $1 ))
    if (( s < 120 )); then echo "${s}s"; elif (( s < 7200 )); then echo "$(( s / 60 ))m"; else echo "$(( s / 3600 ))h"; fi
}
[ -f "$run/.last-setup" ] && echo "dev server last set up $(ago "$(cat "$run/.last-setup")") ago"
[ -f "$run/logs/latest.log" ] && echo "dev server log last written $(ago "$(stat -f %m "$run/logs/latest.log")") ago"
pids=$(lsof -t "$run/world/session.lock" 2>/dev/null)
if [ -n "$pids" ]; then
    for pid in $pids; do
        echo "a dev server (pid $pid, up $(ps -o etime= -p "$pid" | tr -d ' ')) still holds the world"
    done
    echo "waiting up to 60s for it to finish saving..."
    for _ in $(seq 1 60); do
        lsof "$run/world/session.lock" >/dev/null 2>&1 || exit 0
        sleep 1
    done
    echo "it's still running: stop it with 'just rcon stop', then run 'just server-setup' again" >&2
    exit 1
fi
