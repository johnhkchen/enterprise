      "door": "front_path_1 at the door's column",
      "light": "lamp tiles at most 5 columns apart"
    },
    "back": {
      "default": { "hamlet": ["kitchen", "woodpile", "hens"], "village": ["kitchen", "wash", "woodpile", "well", "hens"], "town": ["wash", "tree", "kitchen", "well"], "city": ["tree", "wash"] },
      "by_trade": { "shepherd": "trade:dyer" }
