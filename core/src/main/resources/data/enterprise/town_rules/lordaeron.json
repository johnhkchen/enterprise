    "town": { "centre": "enterprise:lordaeron/forum/market_cross_7x7_a", "facing": "the market hall on the forum's north side", "ring": [{ "stalls": "facing the bell" }, { "trees": "oak in the four corners" }] }
  },
  "avenues": {
    "village": { "edge": "hedge both sides where no plot fronts", "lamp": { "post": "spruce fence, lantern", "every": 8 } },
    "town": { "tree": "minecraft:oak", "every": 6, "offset": 3, "lamp": { "every": 6, "between_trees": true }, "paving": "the avenue's 3 wide in packed mud and gravel" },
    "city": { "tree": "lime (birch) and oak alternating", "every": 5, "paving": "stone bricks" }
