  "growth": {
    "rule": "a plot keeps its slot as the town grows: a hamlet's 7-wide cottage gives way to a 10-wide house on the merged plot when the ward fills; a home's palette steps up (daub to brick) at town tier on the seed's hash; yards follow the house's tier",
    "never": "lose a bed or a workstation the census counted"
  },
  "zoning": {
    "about": "The planned town (thread 0012): the plan is laid at founding for the town's eventual tier; plots fill in `fill_order`; each plot takes its body, kind, storeys, palette and roof from its street class and its band (distance from the bell along the streets, in blocks). Bands and streets are read in this order: the first rule that matches wins. Unbuilt plots carry yard or field tiles (`placeholder`) until their house comes. For a kit race each rule names a part instead of a body; plots are whole tiles (thread 0016), as many as the part needs.",
    "streets": {
      "avenue": "a street from a gate to the forum",
      "forum_front": "a plot whose front faces the forum",
      "lane": "a street between wards",
      "ward_back": "a plot reached only from inside a ward"
    },
    "bands": [
      {
        "name": "core",
        "to": 40
      },
      {
        "name": "inner",
        "from": 40,
        "to": 90
      },
      {
        "name": "outer",
        "from": 90,
        "to": 160
      },
      {
        "name": "fringe",
        "from": 160
      }
    ],
    "fill_order": [
      "forum_front",
      "avenue:core",
      "avenue:inner",
      "lane:core",
      "avenue:outer",
      "lane:inner",
      "lane:outer",
      "ward_back",
      "fringe"
    ],
    "rules": [
      {
        "street": "forum_front",
        "use": "the forum frontage: the tavern first, then the temple, then homes",
        "part": "enterprise:tauren/hall/lodge_18x14_a"
      },
      {
        "street": "avenue",
        "band": [
          "core",
          "inner"
        ],
        "part": {
          "enterprise:tauren/home/yurt_14x10_a": 2,
          "enterprise:tauren/home/tent_10x10_a": 1
        },
        "workshop": "the smith's workshop on the first avenue plot nearest the forum"
      },
      {
